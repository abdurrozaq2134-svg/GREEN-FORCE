# Subdomain per event: <slug>.<host> menampilkan halaman event publik.
# Kosongkan untuk mematikan fitur ini sepenuhnya (rute subdomain tidak
# didaftarkan).
#
# Nilai di bawah pakai sslip.io: layanan DNS publik gratis yang me-resolve
# <apapun>.127.0.0.1.sslip.io ke 127.0.0.1 secara otomatis (wildcard
# sungguhan) -- tidak perlu edit hosts file atau akses Administrator sama
# sekali, dan berlaku untuk slug event apa pun tanpa didaftarkan satu-satu.
# Butuh koneksi internet (DNS lookup beneran), tapi trafiknya tetap ke
# server lokal ini. Ganti ke domain asli (mis. racikevent.com) + DNS
# wildcard kalau sudah deploy ke production.
EVENT_SUBDOMAIN_HOST=127.0.0.1.sslip.io

